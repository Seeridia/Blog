---
import HeroSignature from '@/components/home/HeroSignature.astro'
import config from '@/site-config'

import '@/assets/styles/hero.css'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<script is:inline>
  try {
    document.documentElement.toggleAttribute(
      'data-hero-seen',
      sessionStorage.getItem('hero-seen') === '1'
    )
    sessionStorage.setItem('hero-seen', '1')
  } catch {
    /* Storage may be disabled by the browser. */
  }
</script>

<section class:list={['hero', className]}>
  <div class='hero__content'>
    <p class='hero__tagline'>Developer & Designer</p>
    <h1 class='sr-only'>{config.author}</h1>
    <div class='hero__title' aria-hidden='true'>
      <HeroSignature class='hero__signature' />
    </div>
    <p class='hero__description'>
      To wonder, and to feel.<br />
      去思索，也去感受
    </p>
    <div class='hero__actions'>
      <a href='/blog'>阅读文章 <span aria-hidden='true'>↗</span></a>
      <a href='/projects'>查看作品 <span aria-hidden='true'>↗</span></a>
    </div>
  </div>
</section>
