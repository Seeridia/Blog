---
import config from 'virtual:config'

import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

import FooterCard from './FooterCard.astro'

const footerConf = config.footer
const social = [...(footerConf.social || [])]
const hasRss = social.some(({ icon }) => icon === 'rss')

// If the list does not contain RSS, add it
if (!hasRss)
  social.push({
    icon: 'rss',
    label: 'RSS',
    href: '/rss.xml'
  })

const footerLink1 = footerConf.links?.filter(({ pos }) => pos === 1) || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div
        class='flex items-center gap-x-4 gap-y-2 text-muted-foreground text-sm max-sm:flex-col [&_a]:text-foreground'
      >
        {
          footerLink1.length > 0 && (
            <div>
              {footerLink1.map(({ title, link, style }, index) => (
                <span>
                  <a href={link} target='_blank' class={style}>
                    {title}
                  </a>
                  {index < footerLink1.length - 1 && ' • '}
                </span>
              ))}
            </div>
          )
        }
        <div>
          {config.footer.year}
          {config.author}
        </div>
      </div>

      {/* Social Brands */}
      <div class='flex items-center gap-x-4'>
        {
          social.length > 0 &&
            social.map(({ icon, label, href }) => (
              <a
                class='inline-block text-muted-foreground transition-all hover:text-muted-foreground/75'
                href={href}
                aria-label={label}
              >
                <Icon name={icon as IconsType} />
              </a>
            ))
        }
      </div>
    </div>
  </div>
  <FooterCard />
</footer>
