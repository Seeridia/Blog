---
import config from '@/site-config'
---

{config.integ.waline.enable && <waline-counts data-server={config.integ.waline.server} />}
<script>
  import { commentCount } from '@waline/client/comment'
  import { pageviewCount } from '@waline/client/pageview'

  import { normalizeWalinePath } from './path'

  class WalineCounts extends HTMLElement {
    aborts: (() => void)[] = []
    connectedCallback() {
      const serverURL = this.dataset.server ?? ''
      const path = normalizeWalinePath(window.location.pathname)
      if (document.querySelector('.waline-pageview-count')) {
        this.aborts.push(pageviewCount({ serverURL, path }))
      }
      if (document.querySelector('.waline-comment-count')) {
        this.aborts.push(commentCount({ serverURL, path }))
      }
    }
    disconnectedCallback() {
      this.aborts.forEach((abort) => abort())
      this.aborts = []
    }
  }
  if (!customElements.get('waline-counts')) customElements.define('waline-counts', WalineCounts)
</script>
