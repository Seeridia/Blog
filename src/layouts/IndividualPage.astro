---
import type { MarkdownHeading, MarkdownLayoutProps } from 'astro'

import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/ContentLayout.astro'
import TOC from '@/components/content/TOC.astro'

type Props = MarkdownLayoutProps<{
  title: string
  description: string
  heroImage?: { src: string }
  language?: string
  back?: string
}> & { headings: MarkdownHeading[] }
const { frontmatter, headings } = Astro.props
const { title, description, heroImage, language, back } = frontmatter
---

<PageLayout meta={{ title, description, ogImage: heroImage?.src }} back={back ?? '/'}>
  {!!headings.length && <TOC {headings} slot='sidebar' />}
  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:text-3xl'>{title}</h1>
    <div class='mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground'>
      {
        language && (
          <span class='flex items-center gap-1'>
            <Icon name='earth' />
            {language}
          </span>
        )
      }
      {description && <p>{description}</p>}
    </div>
  </Fragment>
  <slot />
</PageLayout>
